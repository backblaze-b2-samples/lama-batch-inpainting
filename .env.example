# Backblaze B2 (S3-compatible API) — required
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# Region only — the S3 endpoint is derived as https://s3.<region>.backblazeb2.com
B2_REGION=your_region

# Optional. Base URL for building public object links. Leave empty to render
# assets via short-lived presigned URLs (the app works fine without it).
B2_PUBLIC_URL_BASE=

# Optional. Path to a pre-downloaded Big-LaMa checkpoint (big-lama.pt) for
# offline / pre-baked runs. Leave empty to auto-download on first inpaint.
# LAMA_MODEL=/path/to/big-lama.pt

# Optional server knobs (safe defaults live in
# services/api/app/config/settings.py — uncomment only to override):
# API_PORT=8000
# API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# API_CORS_ORIGIN_REGEX=              # dev-only, e.g. ^http://localhost:\d+$
# MAX_FILE_SIZE=104857600             # bytes (default 100MB)
# DOWNLOAD_COUNT_FILE=data/download_count.json

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=00abcdef1234567000000001
# B2_APPLICATION_KEY=<the application key B2 shows once when you create it>
# B2_BUCKET_NAME=my-inpainting-bucket
# B2_REGION=us-west-004
